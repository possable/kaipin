# 放到 /etc/systemd/system/kaipin-remind.timer
# 启用：systemctl daemon-reload && systemctl enable --now kaipin-remind.timer

[Unit]
Description=每日触发 Kaipin 超期/信息缺失提醒扫描

[Timer]
# 每日 09:30 发超期、信息缺失等提醒；到期前提醒由 kaipin-remind-upcoming.timer 单独发
OnCalendar=*-*-* 09:30:00
Persistent=true
Unit=kaipin-remind.service

[Install]
WantedBy=timers.target
